# DO NOT EDIT THIS FILE
#
# Please edit /boot/orangepiEnv.txt, /boot/radxaEnv.txt or /boot/a733-allwinnerEnv.txt
#

setenv load_addr 0x43100000
setenv overlay_error false
setenv verbosity 1
setenv console both
setenv bootlogo true
setenv rootfstype ext4
setenv docker_optimizations on
setenv earlycon off

echo Boot script loaded from 

if test -e   radxaEnv.txt; then
	load    radxaEnv.txt
	env import -t  
elif test -e   orangepiEnv.txt; then
	load    orangepiEnv.txt
	env import -t  
elif test -e   a733-allwinnerEnv.txt; then
	load    a733-allwinnerEnv.txt
	env import -t  
fi

if test  = disabled; then setenv logo logo.nologo; fi

# Dual console support: tty1 at the end so it is primary interactive console on HDMI / DP
if test  = display; then setenv consoleargs console=tty1; fi
if test  = serial; then setenv consoleargs console=ttyS0,115200; fi
if test  = both; then setenv consoleargs console=ttyS0,115200 console=tty1; fi

if test  = on; then setenv consoleargs earlyprintk=sunxi-uart,0x02500000 ; fi

if test  = true; then
	setenv consoleargs quiet splash plymouth.ignore-serial-consoles vt.global_cursor_default=0 systemd.show_status=auto rd.udev.log_level=3 ;
else
	setenv consoleargs splash=verbose 
fi

part uuid  :1 partuuid

if test -z ; then rootdev=/dev/mmcblk0p1; fi

setenv bootargs root= rootwait rootdelay=1 rootfstype= consoleblank=0 loglevel= clk_ignore_unused swiotlb=65536 usb-storage.quirks= 

if test  = on; then setenv bootargs  cgroup_enable=cpuset cgroup_memory=1 cgroup_enable=memory swapaccount=1; fi

load    uInitrd
load    uImage

if load    dtb/; then
	echo Loaded DTB from dtb/
elif load    ; then
	echo Loaded DTB from 
elif load    dtb/allwinner/sun60i-a733-orangepi-4-pro.dtb; then
	echo Loaded fallback DTB sun60i-a733-orangepi-4-pro.dtb
fi

fdt addr 
fdt resize 65536
for overlay_file in ; do
	if load    dtb/allwinner/overlay/-.dtbo; then
		echo Applying kernel provided DT overlay -.dtbo
		fdt apply  || setenv overlay_error true
	fi
done
for overlay_file in ; do
	if load    overlay-user/.dtbo; then
		echo Applying user provided DT overlay .dtbo
		fdt apply  || setenv overlay_error true
	fi
done

bootm   
