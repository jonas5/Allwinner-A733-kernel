# DO NOT EDIT THIS FILE
#
# Please edit /boot/orangepiEnv.txt, /boot/radxaEnv.txt, /boot/bananapiEnv.txt or /boot/a733-allwinnerEnv.txt
#

setenv load_addr "0x43100000"
setenv overlay_error "false"
# default values: silent bootsplash with UART serial console only
setenv verbosity "1"
setenv console "serial"
setenv bootlogo "true"
setenv rootfstype "ext4"
setenv docker_optimizations "on"
setenv earlycon "off"
setenv fdtfile "allwinner/sun60i-a733-orangepi-4-pro.dtb"
setenv overlay_prefix "sun60i-a733"

echo "Boot script loaded from ${devtype} ${devnum}"

if test -e ${devtype} ${devnum} ${prefix}bananapiEnv.txt; then
	load ${devtype} ${devnum} ${load_addr} ${prefix}bananapiEnv.txt
	env import -t ${load_addr} ${filesize}
elif test -e ${devtype} ${devnum} ${prefix}radxaEnv.txt; then
	load ${devtype} ${devnum} ${load_addr} ${prefix}radxaEnv.txt
	env import -t ${load_addr} ${filesize}
elif test -e ${devtype} ${devnum} ${prefix}orangepiEnv.txt; then
	load ${devtype} ${devnum} ${load_addr} ${prefix}orangepiEnv.txt
	env import -t ${load_addr} ${filesize}
elif test -e ${devtype} ${devnum} ${prefix}a733-allwinnerEnv.txt; then
	load ${devtype} ${devnum} ${load_addr} ${prefix}a733-allwinnerEnv.txt
	env import -t ${load_addr} ${filesize}
fi

if test "${logo}" = "disabled"; then setenv logo "logo.nologo"; fi

# Console configuration:
# serial:  UART ttyS0 only (leaves HDMI completely free of kernel logs for clean bootsplash)
# display: HDMI tty1 only
# both:    UART ttyS0 + HDMI tty1 (verbose debug mode)
if test "${console}" = "display"; then setenv consoleargs "console=tty1"; fi
if test "${console}" = "serial"; then setenv consoleargs "console=ttyS0,115200"; fi
if test "${console}" = "both"; then setenv consoleargs "console=ttyS0,115200 console=tty1"; fi

if test "${earlycon}" = "on"; then setenv consoleargs "earlyprintk=sunxi-uart,0x02500000 ${consoleargs}"; fi

if test "${bootlogo}" = "true"; then
	setenv consoleargs "quiet splash plymouth.ignore-serial-consoles vt.global_cursor_default=0 systemd.show_status=auto rd.udev.log_level=3 ${consoleargs}"
else
	setenv consoleargs "splash=verbose console=tty1 ${consoleargs}"
fi

part uuid ${devtype} ${devnum}:1 partuuid

if test -z "${rootdev}"; then rootdev=PARTUUID="${partuuid}"; fi
if test -z "${rootdev}"; then rootdev=/dev/mmcblk0p1; fi

setenv bootargs "root=${rootdev} rootwait rootdelay=1 rootfstype=${rootfstype} ${consoleargs} consoleblank=0 loglevel=${verbosity} clk_ignore_unused swiotlb=65536 usb-storage.quirks=${usbstoragequirks} ${extraargs} ${extraboardargs}"

if test "${docker_optimizations}" = "on"; then setenv bootargs "${bootargs} cgroup_enable=cpuset cgroup_memory=1 cgroup_enable=memory swapaccount=1"; fi

load ${devtype} ${devnum} ${ramdisk_addr_r} ${prefix}uInitrd
load ${devtype} ${devnum} ${kernel_addr_r} ${prefix}uImage

if load ${devtype} ${devnum} ${fdt_addr_r} ${prefix}dtb/${fdtfile}; then
	echo "Loaded DTB from dtb/${fdtfile}"
elif load ${devtype} ${devnum} ${fdt_addr_r} ${prefix}${fdtfile}; then
	echo "Loaded DTB from ${fdtfile}"
elif load ${devtype} ${devnum} ${fdt_addr_r} ${prefix}dtb/allwinner/sun60i-a733-orangepi-4-pro.dtb; then
	echo "Loaded fallback DTB sun60i-a733-orangepi-4-pro.dtb"
fi

fdt addr ${fdt_addr_r}
fdt resize 65536
for overlay_file in ${overlays}; do
	if load ${devtype} ${devnum} ${load_addr} ${prefix}dtb/allwinner/overlay/${overlay_prefix}-${overlay_file}.dtbo; then
		echo "Applying kernel provided DT overlay ${overlay_prefix}-${overlay_file}.dtbo"
		fdt apply ${load_addr} || setenv overlay_error "true"
	fi
done
for overlay_file in ${user_overlays}; do
	if load ${devtype} ${devnum} ${load_addr} ${prefix}overlay-user/${overlay_file}.dtbo; then
		echo "Applying user provided DT overlay ${overlay_file}.dtbo"
		fdt apply ${load_addr} || setenv overlay_error "true"
	fi
done

bootm ${kernel_addr_r} ${ramdisk_addr_r} ${fdt_addr_r}
